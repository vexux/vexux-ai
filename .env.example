# Safe local default. Use mistral/ollama/qwen explicitly for those providers.
MODEL_PROVIDER=fake
FAKE_MODEL=fake-model
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
QWEN_MODEL=Qwen/Qwen2.5-0.5B-Instruct

ENABLE_LOCAL_RAG_INFERENCE=0
ENABLE_AUTONOMOUS_DELEGATION=0
MAX_AUTONOMOUS_DELEGATIONS=4
AGENT_MAX_PARALLEL_TASKS=1
PERSISTENT_MEMORY_DB=
SQL_DATABASE_PATH=

ENABLE_KNOWLEDGE_GRAPH=1
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_GRAPH_NAME=neo4j

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=vexux_fraud
MYSQL_USER=vexux_app
MYSQL_PASSWORD=

# Live Mistral tests remain disabled unless this is explicitly set to 1.
RUN_LIVE_MISTRAL_TESTS=0
